# RadioDJ Environment Variables
# Copy this file to .env and fill in the values from your welcome email (subscribers)
# or from Supabase Dashboard → Settings → API (platform owner)

# Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to share — RLS controls access)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Local file server URL — change only if you run server.mjs on a different port
VITE_FILE_SERVER_URL=http://localhost:3001
